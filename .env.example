NODE_ENV=development
PORT=4000
DATABASE_URL=postgres://talasey:talasey@localhost:5432/api
# Started by `npm run db`. Leave empty to keep sessions, cache, slot locks and jobs in memory.
REDIS_URL=redis://localhost:6379
# The site, for links in emails and for asking it to refresh cached pages.
WEB_URL=http://localhost:3000
# Shared with the frontend so it can refresh pages after a change. At least 32 characters.
REVALIDATE_SECRET=
# How long staff stay signed in without using the admin.
SESSION_DAYS=7
# How long a checkout holds a pallet delivery day before it's offered to someone else.
SLOT_HOLD_MINUTES=15
# How many working days of slots to offer after the zone's lead time.
SLOT_DAYS_AHEAD=10
# Stripe test or live keys. Empty means checkout uses the labelled test payment instead.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
# Where uploaded photos and files are saved (relative to this folder).
UPLOAD_DIR=.data/uploads
# Where contact messages and site survey requests are emailed.
ENQUIRIES_TO=sales@talasey.co.uk
# Cloudflare R2 bucket for uploaded photos. Set all four to use it instead of UPLOAD_DIR.
# The account ID is in the dashboard address; the keys come from an R2 API token with
# Object Read and Write on this bucket only.
R2_ACCOUNT_ID=
R2_BUCKET=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=

# The site assistant (Tala). Leave the key empty to keep it switched off.
ANTHROPIC_API_KEY=
ASSISTANT_MODEL=claude-sonnet-5-5
ASSISTANT_MESSAGES_PER_HOUR=40
ASSISTANT_MESSAGES_PER_DAY=3000
# The model's price in US dollars per million tokens (anthropic.com/pricing), for the cost shown in
# the admin. Leave empty to show token counts only.
ASSISTANT_USD_PER_MTOK_INPUT=
ASSISTANT_USD_PER_MTOK_CACHED=
ASSISTANT_USD_PER_MTOK_OUTPUT=
